# ローカル実行時に必要な環境変数のサンプル。
# 実際の値は GitHub Actions では Secrets として設定し、このファイルはコミットしない。

# Firebase サービスアカウントの JSON 全文（1行にまとめる）
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"iyokoraattendanceapp", ...}

# LINE Messaging API のチャネルアクセストークン
LINE_CHANNEL_ACCESS_TOKEN=

# 通知先の LINE ユーザーID
LINE_USER_ID=
